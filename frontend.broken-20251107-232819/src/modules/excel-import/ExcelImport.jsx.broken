import React, { useState } from 'react';
import axios from 'axios';
import { Download, AlertCircle, ChevronLeft, ChevronRight, CheckCircle, Layers, Zap } from 'lucide-react';

export default function ExcelImport() {
  const [file, setFile] = useState(null);
  const [sheets, setSheets] = useState([]);
  const [selectedSheet, setSelectedSheet] = useState(null);
  const [preview, setPreview] = useState(null);
  const [loading, setLoading] = useState(false);
  const [importingAll, setImportingAll] = useState(false);
  const [editedData, setEditedData] = useState([]);
  const [showOnlyErrors, setShowOnlyErrors] = useState(false);
  const [currentPage, setCurrentPage] = useState(1);
  const rowsPerPage = 8;

  const handleDownloadTemplate = async () => {
    try {
      const res = await axios.get('/sistema/api/v1/excel/template', { responseType: 'blob' });
      const url = window.URL.createObjectURL(new Blob([res.data]));
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', 'GTL_Template_Ingresos.xlsx');
      document.body.appendChild(link);
      link.click();
      link.remove();
    } catch (err) {
      alert('Error descargando template');
    }
  };

  const handleFileSelect = async (selectedFile) => {
    setFile(selectedFile);
    setSheets([]);
    setSelectedSheet(null);
    setPreview(null);
    
    const formData = new FormData();
    formData.append('file', selectedFile);
    
    try {
      const res = await axios.post('/sistema/api/v1/excel/sheets', formData);
      setSheets(res.data.sheets);
      if (res.data.sheets.length === 1) {
        setSelectedSheet(res.data.sheets[0]);
      }
    } catch (err) {
      alert('Error leyendo hojas del Excel');
    }
  };

  const handleImportAll = async () => {
    if (!file) return;
    
    if (!confirm(`¿Importar TODAS las ${sheets.length} hojas automáticamente?\n\nEsto procesará:\n${sheets.join('\n')}`)) {
      return;
    }
    
    const formData = new FormData();
    formData.append('file', file);
    
    setImportingAll(true);
    try {
      const res = await axios.post('/sistema/api/v1/excel/import-all-sheets', formData);
      
      // Mostrar resultado detallado
      const successSheets = res.data.sheets.filter(s => s.status === 'success');
      const skippedSheets = res.data.sheets.filter(s => s.status === 'skipped');
      const errorSheets = res.data.sheets.filter(s => s.status === 'error');
      
      let msg = `✅ IMPORTACIÓN COMPLETA\n\n`;
      msg += `📊 Total importado: ${res.data.total_imported} registros\n`;
      msg += `✅ Hojas procesadas: ${successSheets.length}\n`;
      
      if (successSheets.length > 0) {
        msg += `\n✓ Hojas exitosas:\n`;
        successSheets.forEach(s => {
          msg += `  • ${s.sheet}: ${s.imported} registros`;
          if (s.errors > 0) msg += ` (${s.errors} omitidos)`;
          msg += `\n`;
        });
      }
      
      if (skippedSheets.length > 0) {
        msg += `\n⚠ Hojas omitidas:\n`;
        skippedSheets.forEach(s => {
          msg += `  • ${s.sheet}: ${s.reason}\n`;
        });
      }
      
      if (errorSheets.length > 0) {
        msg += `\n❌ Hojas con errores:\n`;
        errorSheets.forEach(s => {
          msg += `  • ${s.sheet}: ${s.reason}\n`;
        });
      }
      
      alert(msg);
      
      // Resetear
      setFile(null);
      setSheets([]);
      setSelectedSheet(null);
      setPreview(null);
      
    } catch (err) {
    if (!confirm(`¿Importar TODAS las ${sheets.length} hojas automáticamente?\n\nEsto procesará:\n${sheets.join("\n")}`)) {
    }
    setImportingAll(false);
  };

  const handleUpload = async (sheetName) => {
    const formData = new FormData();
    formData.append('file', file);
    if (sheetName) {
      formData.append('sheet_name', sheetName);
    }
    
    setLoading(true);
    try {
      const res = await axios.post('/sistema/api/v1/excel/preview', formData);
      setPreview(res.data);
      setEditedData(res.data.preview.map((row, idx) => ({
        ...row,
        _index: idx,
        _hasError: !row.FECHA || !row.CLIENTE || !row.MONTO || isNaN(parseFloat(row.MONTO))
      })));
      setCurrentPage(1);
    } catch (err) {
      alert('Error: ' + (err.response?.data?.detail || err.message));
    }
    setLoading(false);
  };

  const handleEdit = (index, field, value) => {
    const updated = [...editedData];
    const rowIdx = updated.findIndex(r => r._index === index);
    updated[rowIdx][field] = value;
    
    const row = updated[rowIdx];
    const hasError = !row.FECHA || !row.CLIENTE || !row.MONTO || isNaN(parseFloat(row.MONTO));
    updated[rowIdx]._hasError = hasError;
    
    setEditedData(updated);
  };

  const handleConfirm = async () => {
    const cleanData = editedData.map(({ _index, _hasError, _original_index, ...rest }) => rest);
    try {
      const res = await axios.post('/sistema/api/v1/excel/confirm', { 
        registros: cleanData,
        filename: preview.filename,
        skip_errors: true
      });
      alert(res.data.message);
      setPreview(null);
      setFile(null);
      setEditedData([]);
      setSheets([]);
      setSelectedSheet(null);
    } catch (err) {
      alert('Error: ' + (err.response?.data?.detail || err.message));
    }
  };

  const filteredData = showOnlyErrors 
    ? editedData.filter(row => row._hasError)
    : editedData;

  const totalPages = Math.ceil(filteredData.length / rowsPerPage);
  const startIdx = (currentPage - 1) * rowsPerPage;
  const displayData = filteredData.slice(startIdx, startIdx + rowsPerPage);
  const errorCount = editedData.filter(row => row._hasError).length;

  const columnConfig = {
    'FECHA': { width: '180px', label: 'Fecha' },
    'CLIENTE': { width: '500px', label: 'Cliente' },
    'MONTO': { width: '160px', label: 'Monto' },
    'MONEDA': { width: '120px', label: 'Moneda' },
    'AWB': { width: '200px', label: 'AWB' },
    'DESCRIPCION': { width: '400px', label: 'Descripción' },
    'MES': { width: '150px', label: 'Mes' }
  };

  const orderedColumns = preview ? [
    'FECHA', 'CLIENTE', 'MONTO', 'MONEDA', 'AWB', 'DESCRIPCION', 'MES',
    ...preview.columnas.filter(c => !Object.keys(columnConfig).includes(c))
  ].filter(c => preview.columnas.includes(c)) : [];

  return (
    <div className="min-h-screen bg-gray-50 p-6">
      <div className="max-w-[2000px] mx-auto">
        
        <div className="bg-white rounded-lg shadow-sm p-6 mb-6">
          <div className="flex justify-between items-center">
            <div>
              <h1 className="text-3xl font-bold text-gray-900">Importar Excel</h1>
              {preview?.column_mapping && Object.keys(preview.column_mapping).length > 0 && (
                <p className="text-sm text-green-600 mt-1 flex items-center gap-1">
                  <CheckCircle size={16} />
                  {Object.keys(preview.column_mapping).length} columnas mapeadas | Hoja: {preview.sheet_name}
                </p>
              )}
            </div>
            <button
              onClick={handleDownloadTemplate}
              className="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg transition font-medium"
            >
              <Download size={20} />
              Descargar Plantilla
            </button>
          </div>
        </div>
      
        {!preview && (
          <div className="bg-white rounded-lg shadow-sm p-12">
            <div className="max-w-xl mx-auto text-center">
              <div className="mb-6">
                <svg className="mx-auto h-20 w-20 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 48 48">
                  <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" strokeWidth={2} strokeLinecap="round" strokeLinejoin="round" />
                </svg>
              </div>
              <input
                type="file"
                accept=".xlsx,.xls"
                onChange={(e) => handleFileSelect(e.target.files[0])}
                className="hidden"
                id="file-upload"
              />
              <label htmlFor="file-upload" className="cursor-pointer">
                <span className="text-blue-600 hover:text-blue-700 font-semibold text-lg">
                  Seleccionar archivo Excel
                </span>
                <p className="text-gray-500 mt-2">o arrastra y suelta aquí</p>
              </label>
              <p className="text-sm text-gray-400 mt-3">XLSX, XLS (Máx. 10MB)</p>
              
              {file && sheets.length > 0 && (
                <div className="mt-8 p-6 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-lg border-2 border-blue-200">
                  <p className="text-base text-gray-800 mb-5 font-bold flex items-center justify-center gap-2">
                    <Layers size={22} className="text-blue-600" />
                    📄 {file.name} - {sheets.length} hoja{sheets.length > 1 ? 's' : ''}
                  </p>
                  
                  {/* BOTÓN IMPORTAR TODAS */}
                  {sheets.length > 1 && (
                    <div className="mb-6 p-4 bg-gradient-to-r from-purple-500 to-pink-500 rounded-lg">
                      <button
                        onClick={handleImportAll}
                        disabled={importingAll}
                        className="w-full bg-white hover:bg-gray-50 text-purple-700 px-8 py-4 rounded-lg font-bold text-lg disabled:opacity-50 transition flex items-center justify-center gap-3 shadow-lg"
                      >
                        <Zap size={26} className="text-yellow-500" />
                        {importingAll ? '⚡ Importando todas las hojas...' : `⚡ IMPORTAR TODAS LAS ${sheets.length} HOJAS AUTOMÁTICAMENTE`}
                      </button>
                      <p className="text-white text-xs mt-2 text-center font-medium">
                        Procesa todas las hojas en un solo click
                      </p>
                    </div>
                  )}
                  
                  <div className="border-t-2 border-blue-300 pt-5 mt-2">
                    <p className="text-sm text-gray-600 mb-4 font-semibold">O importa una hoja específica:</p>
                    
                    {sheets.length > 1 && (
                      <div className="mb-4">
                        <select
                          value={selectedSheet || ''}
                          onChange={(e) => setSelectedSheet(e.target.value)}
                          className="w-full px-4 py-3 border-2 border-gray-300 rounded-lg text-base font-medium focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                        >
                          <option value="">-- Elige una hoja --</option>
                          {sheets.map(sheet => (
                            <option key={sheet} value={sheet}>{sheet}</option>
                          ))}
                        </select>
                      </div>
                    )}
                    
                    <button
                      onClick={() => handleUpload(selectedSheet)}
                      disabled={loading || (sheets.length > 1 && !selectedSheet)}
                      className="w-full bg-green-600 hover:bg-green-700 text-white px-10 py-3 rounded-lg font-semibold disabled:opacity-50 transition text-lg"
                    >
                      {loading ? '⏳ Analizando...' : '✓ Analizar y Editar Hoja'}
                    </button>
                  </div>
                </div>
              )}
            </div>
          </div>
        )}

        {preview && (
          <div className="space-y-4">
            
            {preview.errores?.length > 0 && (
              <div className="bg-red-50 border-l-4 border-red-500 p-4 rounded-lg">
                <div className="flex items-start gap-3">
                  <AlertCircle className="h-5 w-5 text-red-500 flex-shrink-0 mt-0.5" />
                  <div>
                    <h3 className="font-semibold text-red-800 mb-2">Advertencias</h3>
                    <ul className="text-sm text-red-700 space-y-1">
                      {preview.errores.map((e, i) => <li key={i}>• {e}</li>)}
                    </ul>
                  </div>
                </div>
              </div>
            )}

            {preview.sugerencias?.length > 0 && (
              <div className="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded-lg">
                <div className="flex items-start gap-3">
                  <span className="text-yellow-600 text-lg">💡</span>
                  <div>
                    <h3 className="font-semibold text-yellow-800 mb-2">Información</h3>
                    <ul className="text-sm text-yellow-700 space-y-1">
                      {preview.sugerencias.map((s, i) => <li key={i}>• {s}</li>)}
                    </ul>
                  </div>
                </div>
              </div>
            )}

            <div className="bg-white rounded-lg shadow-sm p-4">
              <div className="flex justify-between items-center">
                <div className="flex items-center gap-6 text-sm">
                  <span className="font-semibold text-gray-900">
                    📊 {preview.total_registros} registros totales
                  </span>
                  {preview.registros_validos && (
                    <span className="text-green-600 font-semibold">
                      ✅ {preview.registros_validos} válidos
                    </span>
                  )}
                  <span className="text-gray-600">
                    Hoja: <span className="font-medium">{preview.sheet_name}</span>
                  </span>
                </div>
                
                {errorCount > 0 && (
                  <label className="flex items-center gap-2 cursor-pointer">
                    <input
                      type="checkbox"
                      checked={showOnlyErrors}
                      onChange={(e) => {
                        setShowOnlyErrors(e.target.checked);
                        setCurrentPage(1);
                      }}
                      className="w-4 h-4 text-red-600 rounded"
                    />
                    <span className="text-sm font-medium text-gray-700">
                      Solo errores ({errorCount})
                    </span>
                  </label>
                )}
              </div>
            </div>

            <div className="bg-white rounded-lg shadow-sm overflow-hidden">
              <div className="overflow-x-auto">
                <table className="w-full">
                  <thead>
                    <tr className="bg-gradient-to-r from-blue-50 to-indigo-50 border-b-2 border-blue-200">
                      <th className="sticky left-0 z-20 bg-blue-100 px-4 py-4 text-left font-bold text-gray-800 text-lg w-16">
                        #
                      </th>
                      {orderedColumns.map(col => (
                        <th 
                          key={col} 
                          className="px-3 py-4 text-left font-bold text-gray-800 text-base whitespace-nowrap"
                          style={{ minWidth: columnConfig[col]?.width || '200px' }}
                        >
                          {columnConfig[col]?.label || col}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {displayData.map((row, idx) => (
                      <tr 
                        key={row._index} 
                        className={`border-b border-gray-100 ${
                          row._hasError ? 'bg-red-50' : idx % 2 === 0 ? 'bg-white' : 'bg-gray-50/50'
                        }`}
                      >
                        <td className="sticky left-0 z-10 bg-inherit px-4 py-2 text-lg font-bold text-gray-700">
                          {row._index + 1}
                        </td>
                        {orderedColumns.map(col => (
                          <td key={col} className="px-3 py-2">
                            <input
                              type="text"
                              value={row[col] || ''}
                              onChange={(e) => handleEdit(row._index, col, e.target.value)}
                              className={`w-full px-4 py-4 text-lg font-medium border-2 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none ${
                                row._hasError && (!row[col] || (col === 'MONTO' && isNaN(parseFloat(row[col]))))
                                  ? 'border-red-400 bg-red-50'
                                  : 'border-gray-200 bg-white'
                              }`}
                              style={{ 
                                minWidth: columnConfig[col]?.width || '200px',
                                width: columnConfig[col]?.width || '200px'
                              }}
                            />
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              {totalPages > 1 && (
                <div className="bg-gray-50 px-6 py-5 flex items-center justify-between border-t">
                  <div className="text-base text-gray-700 font-medium">
                    Mostrando {startIdx + 1} a {Math.min(startIdx + rowsPerPage, filteredData.length)} de {filteredData.length}
                  </div>
                  <div className="flex items-center gap-3">
                    <button
                      onClick={() => setCurrentPage(p => Math.max(1, p - 1))}
                      disabled={currentPage === 1}
                      className="p-3 border-2 border-gray-300 rounded-lg hover:bg-white disabled:opacity-40 transition"
                    >
                      <ChevronLeft size={24} />
                    </button>
                    <span className="px-6 py-2 text-lg font-bold">
                      {currentPage} / {totalPages}
                    </span>
                    <button
                      onClick={() => setCurrentPage(p => Math.min(totalPages, p + 1))}
                      disabled={currentPage === totalPages}
                      className="p-3 border-2 border-gray-300 rounded-lg hover:bg-white disabled:opacity-40 transition"
                    >
                      <ChevronRight size={24} />
                    </button>
                  </div>
                </div>
              )}
            </div>

            <div className="flex gap-4 justify-between bg-white rounded-lg shadow-sm p-6">
              <button
                onClick={() => { 
                  setPreview(null); 
                  setEditedData([]);
                  setSelectedSheet(null);
                }}
                className="px-10 py-4 border-2 border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 font-bold text-lg"
              >
                ← Elegir otra hoja
              </button>
              <button
                onClick={handleConfirm}
                className="px-10 py-4 bg-green-600 text-white rounded-lg hover:bg-green-700 font-bold flex items-center gap-2 text-lg"
              >
                <CheckCircle size={24} />
                Importar {preview.registros_validos || editedData.length} registros válidos
              </button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}

# ===================================
# GTL Sistema Financiero - .gitignore
# ===================================

# === CRÍTICO: NUNCA SUBIR CREDENCIALES ===
.env
backend/.env
*.env
*.env.local
*.env.production

# Claves y secretos
*secret*
*password*
*credentials*
*.pem
*.key

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/env/
*.egg-info/
dist/
build/

# === Node.js / Frontend ===
frontend/node_modules/
frontend/dist/
frontend/.next/
frontend-build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Base de Datos ===
*.sql
*.db
*.sqlite
*.sqlite3
backup_*.sql

# === Logs ===
*.log
logs/
*.log.*

# === IDEs ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# === Testing ===
.pytest_cache/
.coverage
htmlcov/
*.cover

# === Backups ===
*.backup
*.bak
*.old

# === Sistema Operativo ===
Thumbs.db
.DS_Store

# === Temporal ===
tmp/
temp/
*.tmp
